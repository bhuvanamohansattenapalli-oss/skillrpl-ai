// Prisma schema for SkillRPL AI
// Connected to Supabase PostgreSQL Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  WORKER
  ASSESSOR
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  SELF_DECLARATION_COMPLETED
  ASSESSMENT_READY
  SUBMITTED
  UNDER_ASSESSMENT
  COMPLETED
  UNDER_ASSESSOR_REVIEW
  ASSESSMENT_SCHEDULED
  COMPETENT_CERTIFIED
  NOT_YET_COMPETENT
  REJECTED
}

enum EvidenceType {
  PHOTO
  VIDEO
  DOCUMENT
  CERTIFICATE
  OTHER
}

enum AssessmentStatus {
  SCHEDULED
  IN_PROGRESS
  SUBMITTED
  ASSESSED
  FINALIZED
  COMPLETED
  CANCELLED
}

enum CompetencyOutcome {
  COMPETENT
  NOT_YET_COMPETENT
  REASSESSMENT_REQUIRED
}

enum MessageRole {
  USER
  MODEL
  ASSISTANT
  SYSTEM
}

enum MappingStatus {
  SUGGESTED
  ACCEPTED
  REJECTED
  FLAGGED_INCORRECT
  MODIFIED_BY_ASSESSOR
}

// ==========================================
// USER & PROFILES
// ==========================================

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  role            UserRole         @default(WORKER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  workerProfile   WorkerProfile?
  assessorProfile AssessorProfile?
  auditLogs       AuditLog[]

  @@map("users")
}

model WorkerProfile {
  id                  String            @id @default(uuid())
  userId              String            @unique
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  avatarUrl           String?
  dateOfBirth         String?
  gender              String?
  email               String
  phone               String?
  preferredContact    String?           @default("phone")
  aadhaarMasked       String?
  location            String?
  state               String?
  trade               String?           @default("General Technical")
  primaryTrade        String?
  tradeCode           String?
  nsqfLevel           Int               @default(1)
  yearsOfExperience   Float             @default(0)
  profileCompletion   Int               @default(0)
  professionalSummary String?
  bio                 String?
  preferredLanguage   String            @default("English")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  workExperiences     WorkExperience[]
  selfDeclaration     SelfDeclaration?
  evidences           Evidence[]
  rplApplications     RPLApplication[]
  aiConversations     AIConversation[]

  @@map("worker_profiles")
}

model AssessorProfile {
  id                  String        @id @default(uuid())
  userId              String        @unique
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  email               String
  phone               String?
  tradeSpecialization String?       @default("General Assessment")
  assessorRegNumber   String?       @unique
  organization        String?
  nsqfCertifiedLevel  Int           @default(5)
  isAvailable         Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  assessments         Assessment[]

  @@map("assessor_profiles")
}

// ==========================================
// TRADES, QUALIFICATIONS & SKILLS
// ==========================================

model Trade {
  id                 String              @id @default(uuid())
  code               String              @unique
  name               String
  sector             String
  nsqfLevel          Int
  description        String?
  isDemo             Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  qualificationPacks QualificationPack[]
  skills             Skill[]

  @@map("trades")
}

model QualificationPack {
  id                  String                @id @default(uuid())
  code                String                @unique
  qpCode              String
  title               String
  sector              String
  nsqfLevel           Int
  description         String?
  awardingBody        String?               @default("NCVET / Sector Skill Council")
  status              String?               @default("ACTIVE")
  source              String?               @default("National Qualifications Register (NQR)")
  sourceUrl           String?               @default("https://nqr.gov.in")
  version             String?               @default("1.0")
  effectiveDate       DateTime?
  isDemo              Boolean               @default(false)
  tradeId             String
  trade               Trade                 @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  qualificationSkills   QualificationSkill[]
  qualificationUnits    QualificationUnit[]
  qualificationMappings QualificationMapping[]
  rplApplications       RPLApplication[]
  assessmentCriteria    AssessmentCriterion[]
  assessments           Assessment[]

  @@map("qualification_packs")
}

model QualificationUnit {
  id                    String            @id @default(uuid())
  qualificationPackId   String
  qualificationPack     QualificationPack @relation(fields: [qualificationPackId], references: [id], onDelete: Cascade)
  code                  String            // e.g. CON/N0605
  title                 String            // e.g. Lay electrical conduits and cables
  description           String?
  nsqfLevel             Int?
  isMandatory           Boolean           @default(true)
  assessmentCriteriaRef String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  skillKeywords         SkillKeyword[]

  @@index([qualificationPackId])
  @@index([code])
  @@map("qualification_units")
}

model SkillKeyword {
  id                  String            @id @default(uuid())
  qualificationUnitId String
  qualificationUnit   QualificationUnit @relation(fields: [qualificationUnitId], references: [id], onDelete: Cascade)
  keyword             String            // e.g. "wiring", "conduit", "multimeter"
  task                String?           // practical task description
  skill               String?           // competency / skill area
  createdAt           DateTime          @default(now())

  @@index([qualificationUnitId])
  @@index([keyword])
  @@map("skill_keywords")
}

model Skill {
  id                  String               @id @default(uuid())
  name                String
  category            String?
  nsqfLevel           Int                  @default(1)
  isDemo              Boolean              @default(false)
  tradeId             String?
  trade               Trade?               @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  qualificationSkills QualificationSkill[]
  evidenceSkills      EvidenceSkill[]

  @@map("skills")
}

model QualificationSkill {
  id                  String            @id @default(uuid())
  qualificationPackId String
  qualificationPack   QualificationPack @relation(fields: [qualificationPackId], references: [id], onDelete: Cascade)
  skillId             String
  skill               Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  isMandatory         Boolean           @default(true)

  @@unique([qualificationPackId, skillId])
  @@map("qualification_skills")
}

// ==========================================
// WORK EXPERIENCE & SELF DECLARATION
// ==========================================

model WorkExperience {
  id                String        @id @default(uuid())
  workerProfileId   String
  workerProfile     WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  occupation        String
  organization      String
  location          String
  startDate         String
  endDate           String?
  isCurrent         Boolean       @default(false)
  yearsOfExperience Float
  description       String?
  responsibilities  String[]      @default([])
  toolsUsed         String[]      @default([])
  workType          String?
  workEnvironment   String?
  isDemo            Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("work_experiences")
}

model SelfDeclaration {
  id                 String         @id @default(uuid())
  workerProfileId    String         @unique
  workerProfile      WorkerProfile  @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  regularWorkType    String
  commonTasks        String[]       @default([])
  toolsMachinery     String[]       @default([])
  selfReportedScore  Float?
  declaredAt         DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tasks              DeclaredTask[]
  tools              DeclaredTool[]

  @@map("self_declarations")
}

model DeclaredTask {
  id                String          @id @default(uuid())
  selfDeclarationId String
  selfDeclaration   SelfDeclaration @relation(fields: [selfDeclarationId], references: [id], onDelete: Cascade)
  taskName          String
  proficiencyLevel  String
  yearsPerformed    Float?

  @@map("declared_tasks")
}

model DeclaredTool {
  id                String          @id @default(uuid())
  selfDeclarationId String
  selfDeclaration   SelfDeclaration @relation(fields: [selfDeclarationId], references: [id], onDelete: Cascade)
  toolName          String
  frequency         String?
  isOwner           Boolean         @default(false)

  @@map("declared_tools")
}

// ==========================================
// EVIDENCE PORTFOLIO
// ==========================================

model Evidence {
  id                   String          @id @default(uuid())
  workerProfileId      String
  workerProfile        WorkerProfile   @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  title                String
  type                 EvidenceType    @default(PHOTO)
  fileUrl              String
  fileSize             Int?
  mimeType             String?
  description          String?
  isVerifiedByAssessor Boolean         @default(false)
  isDemo               Boolean         @default(false)
  uploadedAt           DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  evidenceSkills       EvidenceSkill[]

  @@map("evidences")
}

model EvidenceSkill {
  id         String   @id @default(uuid())
  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, skillId])
  @@map("evidence_skills")
}

// ==========================================
// RPL APPLICATION & LIFECYCLE
// ==========================================

model RPLApplication {
  id                  String             @id @default(uuid())
  applicationNumber   String             @unique
  workerProfileId     String
  workerProfile       WorkerProfile      @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  qualificationPackId String?
  qualificationPack   QualificationPack? @relation(fields: [qualificationPackId], references: [id], onDelete: SetNull)
  status              ApplicationStatus  @default(DRAFT)
  tradeTitle          String?
  currentStep         Int                @default(1)
  formData            Json?
  submittedAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  assessments           Assessment[]
  aiAnalyses            AIAnalysis[]
  competencyResults     CompetencyResult[]
  experiences           RPLApplicationExperience[]
  skills                RPLApplicationSkill[]
  qualificationMappings QualificationMapping[]

  @@map("rpl_applications")
}

model QualificationMapping {
  id                   String            @id @default(uuid())
  rplApplicationId     String
  rplApplication       RPLApplication    @relation(fields: [rplApplicationId], references: [id], onDelete: Cascade)
  qualificationPackId  String
  qualificationPack    QualificationPack @relation(fields: [qualificationPackId], references: [id], onDelete: Cascade)

  matchScore           Float             // 0-100 system match score
  matchRank            Int               @default(1) // 1 = Best Match, 2 = Alternative, 3 = Possible
  matchReason          String?
  matchedSkills        String[]          @default([])
  matchedTasks         String[]          @default([])
  matchedTools         String[]          @default([])
  experienceRelevance  String?
  potentialGaps        String[]          @default([])
  evidenceRequired     String[]          @default([])
  methodology          String?           @default("HYBRID") // "DETERMINISTIC" | "HYBRID" | "LOCAL_OFFLINE"

  // Assessor Review
  status               MappingStatus     @default(SUGGESTED)
  assessorNotes        String?
  rejectionReason      String?
  reviewedAt           DateTime?
  reviewedByAssessorId String?

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([rplApplicationId])
  @@index([qualificationPackId])
  @@map("qualification_mappings")
}

model RPLApplicationExperience {
  id               String         @id @default(uuid())
  rplApplicationId String
  rplApplication   RPLApplication @relation(fields: [rplApplicationId], references: [id], onDelete: Cascade)
  company          String
  role             String
  startDate        String
  endDate          String?
  isCurrent        Boolean        @default(false)
  responsibilities String?
  tasksPerformed   String?
  toolsUsed        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("rpl_application_experiences")
}

model RPLApplicationSkill {
  id               String         @id @default(uuid())
  rplApplicationId String
  rplApplication   RPLApplication @relation(fields: [rplApplicationId], references: [id], onDelete: Cascade)
  taskName         String
  experienceText   String
  toolsUsed        String
  confidenceLevel  String
  statusLabel      String         @default("Self-declared — pending assessment")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("rpl_application_skills")
}

// ==========================================
// AI ASSISTANT & PREPARATORY ANALYSIS
// ==========================================

model AIConversation {
  id              String         @id @default(uuid())
  workerProfileId String?
  workerProfile   WorkerProfile? @relation(fields: [workerProfileId], references: [id], onDelete: SetNull)
  title           String         @default("RPL Assistance")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  messages        AIMessage[]

  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  timestamp      DateTime       @default(now())

  @@map("ai_messages")
}

model AIAnalysis {
  id                   String          @id @default(uuid())
  rplApplicationId     String?
  rplApplication       RPLApplication? @relation(fields: [rplApplicationId], references: [id], onDelete: SetNull)
  analysisType         String          @default("SKILL_ANALYSIS")
  summary              String?
  strengths            String[]        @default([])
  recommendations      String[]        @default([])
  potentialNsqfLevel   Int?
  confidenceScore      Float?
  isOfficialAssessment Boolean         @default(false)

  // Full Analysis Snapshots
  inputSnapshot        Json?
  result               Json?
  model                String?         @default("gemini-3.6-flash")
  type                 String?         @default("SKILL_ANALYSIS")
  status               String?         @default("COMPLETED")

  createdAt            DateTime        @default(now())

  @@map("ai_analyses")
}

// ==========================================
// ASSESSOR EVALUATION & COMPETENCY RESULTS
// ==========================================

model Assessment {
  id                    String              @id @default(uuid())
  sessionNumber         String?             @unique
  rplApplicationId      String
  rplApplication        RPLApplication      @relation(fields: [rplApplicationId], references: [id], onDelete: Cascade)
  assessorProfileId     String
  assessorProfile       AssessorProfile     @relation(fields: [assessorProfileId], references: [id], onDelete: Cascade)
  qualificationPackId   String?
  qualificationPack     QualificationPack?  @relation(fields: [qualificationPackId], references: [id], onDelete: SetNull)
  scheduledDate         DateTime?
  status                AssessmentStatus    @default(SCHEDULED)
  notes                 String?
  practicalTaskDemo     String?
  conductedAt           DateTime?
  completedAt           DateTime?

  // Phase 4 Dynamic Task Bank & Rubric Assessment Fields
  tasksSnapshot         Json?               // Exact generated/selected task set for auditability & reproducibility
  evidenceReviewed      Json?               // [{ evidenceId, title, verified, remarks }]
  aiAssistanceSummary   Json?               // { notesSummary, missingObservations, criteriaChecklist, consistencyAnalysis, suggestedEvidence }
  systemReferenceScore  Float?              // Calculated score percentage (0 - 100)
  systemReferenceOutcome String?            // "COMPETENT" | "NOT_YET_COMPETENT" (System reference threshold only)
  finalDecision         CompetencyOutcome?  // Official Human Assessor Decision: COMPETENT | NOT_YET_COMPETENT | REASSESSMENT_REQUIRED
  decisionReason        String?             // Mandatory explanation if human decision differs from system reference
  assessorConfirmed     Boolean             @default(false)
  assessorConfirmedAt   DateTime?
  assessorSignature     String?
  interAssessorGroup    String?             // Identifier for comparative inter-assessor consistency tests
  syncedAt              DateTime?
  localDraftVersion     Int                 @default(1)

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  scores                AssessmentScore[]
  competencyResults     CompetencyResult[]
  auditLogs             AssessmentAuditLog[]

  @@map("assessments")
}

model AssessmentCriterion {
  id                  String            @id @default(uuid())
  qualificationPackId String
  qualificationPack   QualificationPack @relation(fields: [qualificationPackId], references: [id], onDelete: Cascade)
  code                String
  description         String
  maxScore            Float             @default(100.0)
  weightage           Float             @default(1.0)

  scores              AssessmentScore[]

  @@map("assessment_criteria")
}

model AssessmentScore {
  id            String               @id @default(uuid())
  assessmentId  String
  assessment    Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criterionId   String?
  criterion     AssessmentCriterion? @relation(fields: [criterionId], references: [id], onDelete: SetNull)
  taskId        String?
  taskTitle     String?
  competencyArea String?
  criterionKey  String?
  criterionText String?
  scoreAwarded  Float                // 0 to 4 standardized rubric score
  rubricLevel   String?              // "Not Demonstrated" | "Needs Significant Support" | "Partially Demonstrated" | "Competent" | "Strongly Demonstrated"
  observation   String?              // Mandatory for score 0 or 1
  remarks       String?
  isMandatory   Boolean              @default(true)
  evaluatedAt   DateTime             @default(now())

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @default(now()) @updatedAt

  @@map("assessment_scores")
}

model AssessmentAuditLog {
  id              String      @id @default(uuid())
  assessmentId    String
  assessment      Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  action          String      // "ASSESSMENT_CREATED" | "TASK_STARTED" | "CRITERION_SCORED" | "SCORE_CHANGED" | "EVIDENCE_REVIEWED" | "AI_ASSISTANCE_REQUESTED" | "ASSESSMENT_SUBMITTED" | "ASSESSMENT_FINALIZED"
  performedById   String?
  performedByRole String?     @default("ASSESSOR")
  details         String?
  previousValue   Json?
  newValue        Json?
  timestamp       DateTime    @default(now())

  @@index([assessmentId])
  @@map("assessment_audit_logs")
}

model CompetencyResult {
  id               String            @id @default(uuid())
  assessmentId     String?
  assessment       Assessment?       @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  rplApplicationId String
  rplApplication   RPLApplication    @relation(fields: [rplApplicationId], references: [id], onDelete: Cascade)
  overallResult    CompetencyOutcome
  finalNsqfLevel   Int
  certifiedDate    DateTime?
  certificateNumber String?          @unique
  assessorRemarks  String?
  createdAt        DateTime          @default(now())

  @@map("competency_results")
}

// ==========================================
// AUDIT LOG
// ==========================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
